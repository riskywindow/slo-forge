        "memory_type": {
          "minLength": 1,
          "title": "Memory Type",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
