{
  "$defs": {
    "ByteRange": {
      "additionalProperties": false,
      "properties": {
        "length": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Length",
          "type": "integer"
        },
        "offset": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "offset",
        "length"
      ],
      "title": "ByteRange",
      "type": "object"
    },
    "DTypeSemantics": {
      "enum": [
        "bool",
        "uint8",
        "int8",
        "int32",
        "int64",
        "float16",
        "bfloat16",
        "float32",
        "float64",
        "fp8",
        "opaque"
      ],
      "title": "DTypeSemantics",
      "type": "string"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "ExactnessClass": {
      "enum": [
        "exact_bitwise",
        "exact_semantic",
        "numerically_equivalent",
        "quality_bounded",
        "recomputation_assisted",
        "incompatible"
      ],
      "title": "ExactnessClass",
      "type": "string"
    },
    "Extensions": {
      "description": "The only extension point; each key names its owning compatibility domain.",
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*/[A-Za-z][A-Za-z0-9_.-]*$": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "title": "Extensions",
      "type": "object"
    },
    "JsonValue": {},
    "MemoryAllocation": {
      "additionalProperties": false,
      "properties": {
