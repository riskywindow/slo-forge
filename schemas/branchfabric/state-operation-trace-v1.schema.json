{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sloforge.io/schemas/branchfabric/state-operation-trace-v1.schema.json",
  "title": "StateOperationTrace v1 event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "sloforge.branchfabric.state-operation-event/v1"},
    "kind": {"const": "StateOperationTraceEvent"},
    "trace_producer_version": {"type": "string", "minLength": 1},
    "collection_level": {"enum": ["disabled", "minimal", "full"]},
    "provenance": {"enum": ["SYNTHETIC", "REPLAYED", "HARDWARE_BACKED_REAL", "SIMULATED_HARDWARE"]},
    "timing_measurement_class": {"enum": ["SYNTHETIC", "REPLAYED", "HARDWARE_BACKED_REAL", "SIMULATED_HARDWARE"]},
    "trace_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "branch_group_id": {"type": ["string", "null"], "minLength": 1},
    "logical_state_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": ["string", "null"]},
    "tenant_id": {"type": "string", "minLength": 1},
    "security_domain": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "process_id": {"type": "integer", "minimum": 0},
    "rank": {"type": ["integer", "null"], "minimum": 0},
    "device": {"type": ["string", "null"]},
    "monotonic_timestamp_ns": {"type": "integer", "minimum": 0},
    "normalized_timestamp_ns": {"type": "integer", "minimum": 0},
    "duration_ns": {"type": "integer", "minimum": 0},
    "clock_source": {"enum": ["monotonic", "monotonic_raw", "perf_counter", "cuda_global_timer", "cupti", "synthetic"]},
    "alignment_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "operation_type": {"enum": ["STATE_ALLOC", "STATE_MAP", "STATE_PUBLISH", "STATE_FORK", "STATE_COW", "STATE_APPEND", "STATE_READ", "STATE_WRITE", "STATE_SNAPSHOT", "STATE_DELTA", "STATE_RESHARD", "STATE_TRANSPOSE", "STATE_REPACK", "STATE_QUANTIZE", "STATE_DEQUANTIZE", "STATE_COMPRESS", "STATE_DECOMPRESS", "STATE_HASH", "STATE_CHECKSUM", "STATE_ENCRYPT", "STATE_DECRYPT", "STATE_SEND", "STATE_RECEIVE", "STATE_MULTICAST", "STATE_ACK", "STATE_RETRY", "STATE_COMMIT", "STATE_ABORT", "STATE_RECLAIM", "STATE_FREE"]},
    "state_segment": {"enum": ["token_history", "kv", "recurrent", "sampler", "guided_decoding", "workflow", "environment", "filesystem", "database", "process_reconstruction", "transaction", "integrity", "runtime_reconstructible", "unknown"]},
    "source_physical_representation": {"type": "string", "minLength": 1},
    "destination_physical_representation": {"type": "string", "minLength": 1},
    "bytes": {"type": "integer", "minimum": 0},
    "alignment_bytes": {"type": "integer", "minimum": 0, "description": "Zero means N/A for a nonpaged operation."},
    "page_size_bytes": {"type": "integer", "minimum": 0, "description": "Zero means N/A for a nonpaged operation."},
    "chunk_size_bytes": {"type": "integer", "minimum": 0, "description": "Zero means N/A for an unchunked operation."},
    "fanout": {"type": "integer", "minimum": 1},
    "dependency_event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "concurrency": {"type": "integer", "minimum": 1},
    "queue_delay_ns": {"type": "integer", "minimum": 0},
    "operation_latency_ns": {"type": "integer", "minimum": 0},
    "cpu_time_ns": {"type": "integer", "minimum": 0},
    "gpu_time_ns": {"type": "integer", "minimum": 0},
    "transfer_time_ns": {"type": "integer", "minimum": 0},
    "result": {"enum": ["success", "failure", "retry", "skipped"]},
    "failure": {"type": ["string", "null"]},
    "state_epoch": {"type": "integer", "minimum": 0},
    "source_location": {"enum": ["gpu_hbm", "gpu_peer_hbm", "host_dram", "pinned_memory", "local_nvme", "remote_storage", "nic", "transport_buffer", "unknown"]},
    "destination_location": {"enum": ["gpu_hbm", "gpu_peer_hbm", "host_dram", "pinned_memory", "local_nvme", "remote_storage", "nic", "transport_buffer", "unknown"]},
    "transport_type": {"enum": ["none", "memory_copy", "pcie", "nvlink", "nccl", "tcp", "rdma", "shared_memory", "storage", "synthetic"]},
    "event_sequence": {"type": "integer", "minimum": 0},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["schema_version", "kind", "trace_producer_version", "collection_level", "provenance", "timing_measurement_class", "trace_id", "session_id", "branch_group_id", "logical_state_id", "branch_id", "tenant_id", "security_domain", "host", "process_id", "rank", "device", "monotonic_timestamp_ns", "normalized_timestamp_ns", "duration_ns", "clock_source", "alignment_confidence", "operation_type", "state_segment", "source_physical_representation", "destination_physical_representation", "bytes", "alignment_bytes", "page_size_bytes", "chunk_size_bytes", "fanout", "dependency_event_ids", "concurrency", "queue_delay_ns", "operation_latency_ns", "cpu_time_ns", "gpu_time_ns", "transfer_time_ns", "result", "failure", "state_epoch", "source_location", "destination_location", "transport_type", "event_sequence", "content_hash"]
}
