{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sloforge.io/schemas/branchfabric/branch-workload-trace-v1.schema.json",
  "title": "BranchWorkloadTrace v1 event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "sloforge.branchfabric.branch-workload-event/v1"},
    "kind": {"const": "BranchWorkloadTraceEvent"},
    "trace_producer_version": {"type": "string", "minLength": 1},
    "collection_level": {"enum": ["disabled", "minimal", "full"]},
    "provenance": {"enum": ["SYNTHETIC", "REPLAYED", "HARDWARE_BACKED_REAL", "SIMULATED_HARDWARE"]},
    "timing_measurement_class": {"enum": ["SYNTHETIC", "REPLAYED", "HARDWARE_BACKED_REAL", "SIMULATED_HARDWARE"]},
    "trace_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "branch_group_id": {"type": ["string", "null"], "minLength": 1},
    "branch_id": {"type": ["string", "null"]},
    "parent_branch_id": {"type": ["string", "null"]},
    "policy_epoch": {"type": ["string", "null"]},
    "environment_id": {"type": ["string", "null"]},
    "transaction_id": {"type": ["string", "null"]},
    "host": {"type": "string", "minLength": 1},
    "process_id": {"type": "integer", "minimum": 0},
    "rank": {"type": ["integer", "null"], "minimum": 0},
    "device": {"type": ["string", "null"]},
    "monotonic_timestamp_ns": {"type": "integer", "minimum": 0},
    "normalized_timestamp_ns": {"type": "integer", "minimum": 0},
    "duration_ns": {"type": "integer", "minimum": 0},
    "clock_source": {"enum": ["monotonic", "monotonic_raw", "perf_counter", "cuda_global_timer", "cupti", "synthetic"]},
    "alignment_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "operation_type": {"enum": ["BRANCH_POINT", "CAPTURE", "ENVIRONMENT_FORK", "BRANCH_FORK", "BRANCH_READY", "BRANCH_DIVERGENCE", "BRANCH_PRUNE", "BRANCH_ABORT", "BRANCH_COMMIT", "BRANCH_COMPLETE", "BRANCH_MIGRATION", "CHECKPOINT", "ROLLOUT", "REWARD", "TRAIN", "EVALUATE", "CANARY", "PROMOTE", "ROLLBACK", "LEARNING_TRANSACTION_STAGE", "STATE_ALLOC", "STATE_MAP", "STATE_PUBLISH", "STATE_FORK", "STATE_COW", "STATE_APPEND", "STATE_READ", "STATE_WRITE", "STATE_SNAPSHOT", "STATE_DELTA", "STATE_RESHARD", "STATE_TRANSPOSE", "STATE_REPACK", "STATE_QUANTIZE", "STATE_DEQUANTIZE", "STATE_COMPRESS", "STATE_DECOMPRESS", "STATE_HASH", "STATE_CHECKSUM", "STATE_ENCRYPT", "STATE_DECRYPT", "STATE_SEND", "STATE_RECEIVE", "STATE_MULTICAST", "STATE_ACK", "STATE_RETRY", "STATE_COMMIT", "STATE_ABORT", "STATE_RECLAIM", "STATE_FREE"]},
    "logical_state_id": {"type": ["string", "null"]},
    "physical_state_id": {"type": ["string", "null"]},
    "state_segment": {"enum": ["model", "token_history", "kv", "recurrent", "sampler", "guided_decoding", "workflow", "environment", "filesystem", "database", "process_reconstruction", "transaction", "integrity", "runtime_reconstructible", "unknown"]},
    "page": {"type": ["integer", "null"], "minimum": 0},
    "version": {"type": ["integer", "null"], "minimum": 0},
    "source_epoch": {"type": ["integer", "null"], "minimum": 0},
    "destination_epoch": {"type": ["integer", "null"], "minimum": 0},
    "logical_bytes": {"type": "integer", "minimum": 0},
    "physical_bytes": {"type": "integer", "minimum": 0},
    "compressed_bytes": {"type": "integer", "minimum": 0},
    "transferred_bytes": {"type": "integer", "minimum": 0},
    "metadata_bytes": {"type": "integer", "minimum": 0},
    "location": {"enum": ["gpu_hbm", "gpu_peer_hbm", "host_dram", "pinned_memory", "local_nvme", "remote_storage", "nic", "transport_buffer", "unknown"]},
    "source_location": {"enum": ["gpu_hbm", "gpu_peer_hbm", "host_dram", "pinned_memory", "local_nvme", "remote_storage", "nic", "transport_buffer", "unknown"]},
    "destination_location": {"enum": ["gpu_hbm", "gpu_peer_hbm", "host_dram", "pinned_memory", "local_nvme", "remote_storage", "nic", "transport_buffer", "unknown"]},
    "shared_root": {"type": "boolean"},
    "private_suffix": {"type": "boolean"},
    "cow_allocation": {"type": "boolean"},
    "queue_delay_ns": {"type": "integer", "minimum": 0},
    "execution_latency_ns": {"type": "integer", "minimum": 0},
    "transfer_latency_ns": {"type": "integer", "minimum": 0},
    "transform_latency_ns": {"type": "integer", "minimum": 0},
    "wait_latency_ns": {"type": "integer", "minimum": 0},
    "cpu_cycles": {"type": ["integer", "null"], "minimum": 0},
    "cpu_time_ns": {"type": ["integer", "null"], "minimum": 0},
    "gpu_duration_ns": {"type": ["integer", "null"], "minimum": 0},
    "transport_type": {"enum": ["none", "memory_copy", "pcie", "nvlink", "nccl", "tcp", "rdma", "shared_memory", "storage", "synthetic"]},
    "transport_source": {"type": ["string", "null"]},
    "transport_destination": {"type": ["string", "null"]},
    "chunk_size_bytes": {"type": ["integer", "null"], "minimum": 1},
    "fanout": {"type": "integer", "minimum": 1},
    "retransmission": {"type": "boolean"},
    "error": {"type": ["string", "null"]},
    "gpu_model": {"type": ["string", "null"]},
    "nic": {"type": ["string", "null"]},
    "numa_node": {"type": ["integer", "null"], "minimum": 0},
    "pcie_path": {"type": ["string", "null"]},
    "network_rail": {"type": ["string", "null"]},
    "memory_tier": {"type": ["string", "null"]},
    "attributes": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"minLength": 1, "maxLength": 128},
      "additionalProperties": {"type": ["boolean", "integer", "number", "string", "null"]}
    },
    "event_sequence": {"type": "integer", "minimum": 0},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["schema_version", "kind", "trace_producer_version", "collection_level", "provenance", "timing_measurement_class", "trace_id", "session_id", "branch_group_id", "branch_id", "parent_branch_id", "policy_epoch", "environment_id", "transaction_id", "host", "process_id", "rank", "device", "monotonic_timestamp_ns", "normalized_timestamp_ns", "duration_ns", "clock_source", "alignment_confidence", "operation_type", "logical_state_id", "physical_state_id", "state_segment", "page", "version", "source_epoch", "destination_epoch", "logical_bytes", "physical_bytes", "compressed_bytes", "transferred_bytes", "metadata_bytes", "location", "source_location", "destination_location", "shared_root", "private_suffix", "cow_allocation", "queue_delay_ns", "execution_latency_ns", "transfer_latency_ns", "transform_latency_ns", "wait_latency_ns", "cpu_cycles", "cpu_time_ns", "gpu_duration_ns", "transport_type", "transport_source", "transport_destination", "chunk_size_bytes", "fanout", "retransmission", "error", "gpu_model", "nic", "numa_node", "pcie_path", "network_rail", "memory_tier", "event_sequence", "content_hash"]
}
