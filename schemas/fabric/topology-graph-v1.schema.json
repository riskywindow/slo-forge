          "title": "Latency Curve Us",
          "type": "array"
        },
        "measured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured At"
        },
        "measurement_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Confidence"
        },
        "measurement_environment_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactDigest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sharing_group": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sharing Group"
        },
        "source_node_id": {
          "minLength": 1,
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "minLength": 1,
          "title": "Target Node Id",
          "type": "string"
        },
        "theoretical_bandwidth_gbps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Theoretical Bandwidth Gbps"
        }
      },
      "required": [
        "edge_id",
        "source_node_id",
        "target_node_id",
        "connection",
        "directionality",
        "duplex",
        "health",
        "discovery_provenance"
      ],
      "title": "TopologyEdge",
      "type": "object"
    }
  },
  "$id": "urn:sloforge:fabric:topology-graph-v1",
