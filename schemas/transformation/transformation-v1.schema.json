        "$ref": "#/$defs/LineageReference"
      },
      "title": "Lineage References",
      "type": "array"
    },
    "parent_transformations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Parent Transformations",
      "type": "array"
    },
    "postconditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Postconditions",
      "type": "array"
    },
    "preconditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "proposal_source": {
      "minLength": 1,
      "title": "Proposal Source",
      "type": "string"
    },
    "required_benchmark_stages": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Benchmark Stages",
      "type": "array"
    },
    "required_verifier_stages": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Required Verifier Stages",
      "type": "array"
    },
    "rollback_strategy": {
      "minLength": 1,
      "title": "Rollback Strategy",
      "type": "string"
