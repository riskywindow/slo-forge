    "api_version": {
      "const": "sloforge.io/genesis/v1",
      "default": "sloforge.io/genesis/v1",
      "title": "Api Version",
      "type": "string"
    },
    "counterexample_references": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Counterexample References",
      "type": "array"
    },
    "designation": {
      "$ref": "#/$defs/TransformationDesignation"
    },
    "expected_performance_change": {
      "items": {
        "$ref": "#/$defs/EstimatedChange"
      },
      "title": "Expected Performance Change",
      "type": "array"
    },
    "expected_quality_cost": {
      "items": {
        "$ref": "#/$defs/EstimatedChange"
      },
      "title": "Expected Quality Cost",
      "type": "array"
    },
    "expected_resource_change": {
      "items": {
        "$ref": "#/$defs/EstimatedChange"
      },
      "title": "Expected Resource Change",
      "type": "array"
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    },
    "family": {
      "$ref": "#/$defs/TransformationFamily"
    },
    "kind": {
      "const": "Transformation",
