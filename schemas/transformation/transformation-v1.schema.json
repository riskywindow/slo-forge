{
  "$defs": {
    "EstimatedChange": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "title": "Expected",
          "type": "number"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "lower",
        "expected",
        "upper",
        "unit"
      ],
      "title": "EstimatedChange",
      "type": "object"
    },
    "Extensions": {
      "description": "The sole extension namespace; keys identify their owning organization.",
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*/[A-Za-z][A-Za-z0-9_.-]*$": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "title": "Extensions",
      "type": "object"
    },
    "GenomePattern": {
      "additionalProperties": false,
      "properties": {
        "node_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Node Ids",
          "type": "array"
        },
        "region": {
          "enum": [
            "workflow",
            "request",
            "serving",
            "state",
            "distributed",
            "tensor",
            "kernel",
            "recovery"
          ],
          "title": "Region",
          "type": "string"
        },
        "structural_constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Structural Constraints",
          "type": "array"
        }
      },
      "required": [
        "region",
        "node_ids",
        "structural_constraints"
      ],
      "title": "GenomePattern",
      "type": "object"
    },
    "JsonValue": {},
    "LearnedConstraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "counterexample_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Counterexample Ids",
          "type": "array"
        },
        "expression": {
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "scope": {
          "enum": [
            "candidate",
            "family",
            "hardware",
            "dependency",
            "universal_precondition"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "constraint_id",
        "expression",
        "scope",
        "counterexample_ids"
      ],
      "title": "LearnedConstraint",
      "type": "object"
    },
    "LineageReference": {
      "additionalProperties": false,
      "properties": {
        "lineage_id": {
          "minLength": 1,
          "title": "Lineage Id",
          "type": "string"
        },
        "relation": {
          "enum": [
            "parent",
            "derived_from",
            "reused",
            "constrained_by",
            "invalidated_by"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "lineage_id",
        "relation"
      ],
      "title": "LineageReference",
      "type": "object"
    },
    "ProofObligation": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "minimum_level": {
          "$ref": "#/$defs/VerificationLevel"
        },
        "obligation_id": {
          "minLength": 1,
          "title": "Obligation Id",
          "type": "string"
        },
        "property": {
          "minLength": 1,
          "title": "Property",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "obligation_id",
        "property",
        "minimum_level",
        "scope"
      ],
      "title": "ProofObligation",
      "type": "object"
    },
    "SemanticCategory": {
      "enum": [
        "exact",
        "approximate",
        "policy",
        "resource",
        "implementation",
        "experimental"
      ],
      "title": "SemanticCategory",
      "type": "string"
    },
    "TransformationDesignation": {
      "enum": [
        "semantics_preserving",
        "approximate_within_quality_budget",
        "policy",
        "resource_only",
        "runtime_implementation",
        "experimental_operator_review"
      ],
      "title": "TransformationDesignation",
      "type": "string"
    },
    "TransformationFamily": {
      "enum": [
        "algebraic_rewrite",
        "tensor_decomposition",
        "operator_fusion",
        "layout_transformation",
        "precision_transformation",
        "quantization_transformation",
        "scheduler_transformation",
        "batching_transformation",
        "cache_policy_transformation",
        "state_layout_transformation",
        "distributed_plan_transformation",
        "communication_transformation",
        "kernel_transformation",
        "workflow_transformation",
        "recovery_transformation",
        "runtime_code_patch"
      ],
      "title": "TransformationFamily",
      "type": "string"
    },
    "VerificationLevel": {
      "enum": [
        "level_0_build",
        "level_1_differential",
        "level_2_property",
        "level_3_bounded_exhaustive",
        "level_4_solver_backed",
        "level_5_hardware_operational"
      ],
      "title": "VerificationLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "affected_regions": {
      "items": {
        "minLength": 1,
        "type": "string"
