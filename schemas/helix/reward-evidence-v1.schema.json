{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EvidencePointer": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "minLength": 1,
          "title": "Captured At",
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "digest",
        "media_type",
        "captured_at"
      ],
      "title": "EvidencePointer",
      "type": "object"
    },
    "LineageReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "minLength": 1,
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "relation": {
          "$ref": "#/$defs/LineageRelation"
        }
      },
      "required": [
        "artifact_id",
        "artifact_kind",
        "relation",
        "digest"
      ],
      "title": "LineageReference",
      "type": "object"
    },
    "LineageRelation": {
      "enum": [
        "source",
        "parent",
        "derived_from",
        "evidence",
        "state",
        "policy"
      ],
      "title": "LineageRelation",
      "type": "string"
    },
    "PolicyEpoch": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "sloforge.io/helix/v1",
          "default": "sloforge.io/helix/v1",
          "title": "Api Version",
          "type": "string"
        },
        "created_at": {
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        },
        "epoch": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "kind": {
          "const": "PolicyEpoch",
          "default": "PolicyEpoch",
          "title": "Kind",
          "type": "string"
        },
        "lineage": {
          "items": {
            "$ref": "#/$defs/LineageReference"
          },
          "title": "Lineage",
          "type": "array"
        },
        "parent_epoch": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Epoch"
        },
        "parent_policy_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_digest": {
          "$ref": "#/$defs/Digest"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "training_transaction_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Transaction Id"
        }
      },
      "required": [
        "policy_id",
        "epoch",
        "policy_digest",
        "created_at",
        "lineage"
      ],
      "title": "PolicyEpoch",
      "type": "object"
    },
    "RewardComponent": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "event_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "policy_epoch": {
          "$ref": "#/$defs/PolicyEpoch"
        },
        "raw_evidence": {
          "$ref": "#/$defs/EvidencePointer"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "component_id",
        "name",
        "value",
        "weight",
        "policy_epoch",
        "event_ids",
        "raw_evidence"
      ],
      "title": "RewardComponent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aggregate_reward": {
      "title": "Aggregate Reward",
      "type": "number"
    },
    "api_version": {
      "const": "sloforge.io/helix/v1",
      "default": "sloforge.io/helix/v1",
      "title": "Api Version",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/RewardComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "evaluated_at": {
      "minLength": 1,
      "title": "Evaluated At",
      "type": "string"
    },
    "evaluator_digest": {
      "$ref": "#/$defs/Digest"
    },
    "kind": {
      "const": "RewardEvidence",
      "default": "RewardEvidence",
      "title": "Kind",
      "type": "string"
    },
    "lineage": {
      "items": {
        "$ref": "#/$defs/LineageReference"
      },
      "title": "Lineage",
      "type": "array"
    },
    "policy_epochs": {
      "items": {
        "$ref": "#/$defs/PolicyEpoch"
      },
      "title": "Policy Epochs",
      "type": "array"
    },
    "reward_evidence_id": {
      "minLength": 1,
      "title": "Reward Evidence Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trajectory_digest": {
      "$ref": "#/$defs/Digest"
    },
    "trajectory_id": {
      "minLength": 1,
      "title": "Trajectory Id",
      "type": "string"
    }
  },
  "required": [
    "reward_evidence_id",
    "trajectory_id",
    "trajectory_digest",
    "policy_epochs",
    "components",
    "aggregate_reward",
    "evaluator_digest",
    "evaluated_at",
    "lineage"
  ],
  "title": "RewardEvidence",
  "type": "object"
}
