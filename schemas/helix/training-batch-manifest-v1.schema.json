{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EvidencePointer": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "minLength": 1,
          "title": "Captured At",
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "digest",
        "media_type",
        "captured_at"
      ],
      "title": "EvidencePointer",
      "type": "object"
    },
    "LineageReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "minLength": 1,
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "relation": {
          "$ref": "#/$defs/LineageRelation"
        }
      },
      "required": [
        "artifact_id",
        "artifact_kind",
        "relation",
        "digest"
      ],
      "title": "LineageReference",
      "type": "object"
    },
    "LineageRelation": {
      "enum": [
        "source",
        "parent",
        "derived_from",
        "evidence",
        "state",
        "policy"
      ],
      "title": "LineageRelation",
      "type": "string"
    },
    "PolicyConsistency": {
      "enum": [
        "strict",
        "segmented"
      ],
      "title": "PolicyConsistency",
      "type": "string"
    },
    "PolicyEpoch": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "sloforge.io/helix/v1",
          "default": "sloforge.io/helix/v1",
          "title": "Api Version",
          "type": "string"
        },
        "created_at": {
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        },
        "epoch": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "kind": {
          "const": "PolicyEpoch",
          "default": "PolicyEpoch",
          "title": "Kind",
          "type": "string"
        },
        "lineage": {
          "items": {
            "$ref": "#/$defs/LineageReference"
          },
          "title": "Lineage",
          "type": "array"
        },
        "parent_epoch": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Epoch"
        },
        "parent_policy_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_digest": {
          "$ref": "#/$defs/Digest"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "training_transaction_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Transaction Id"
        }
      },
      "required": [
        "policy_id",
        "epoch",
        "policy_digest",
        "created_at",
        "lineage"
      ],
      "title": "PolicyEpoch",
      "type": "object"
    },
    "TrainingSampleKind": {
      "enum": [
        "token",
        "action",
        "trajectory"
      ],
      "title": "TrainingSampleKind",
      "type": "string"
    },
    "TrainingSampleProvenance": {
      "additionalProperties": false,
      "properties": {
        "action_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Action Ids",
          "type": "array"
        },
        "behavior_log_probability": {
          "maximum": 0.0,
          "title": "Behavior Log Probability",
          "type": "number"
        },
        "behavior_policy_epoch": {
          "$ref": "#/$defs/PolicyEpoch"
        },
        "credit_evidence_digest": {
          "$ref": "#/$defs/Digest"
        },
        "credit_evidence_id": {
          "minLength": 1,
          "title": "Credit Evidence Id",
          "type": "string"
        },
        "event_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "importance_sampling_weight": {
          "exclusiveMinimum": 0.0,
          "title": "Importance Sampling Weight",
          "type": "number"
        },
        "lineage": {
          "items": {
            "$ref": "#/$defs/LineageReference"
          },
          "title": "Lineage",
          "type": "array"
        },
        "raw_sample": {
          "$ref": "#/$defs/EvidencePointer"
        },
        "reward_evidence_digest": {
          "$ref": "#/$defs/Digest"
        },
        "reward_evidence_id": {
          "minLength": 1,
          "title": "Reward Evidence Id",
          "type": "string"
        },
        "sample_id": {
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        },
        "sample_kind": {
          "$ref": "#/$defs/TrainingSampleKind"
        },
        "target_policy_epoch": {
          "$ref": "#/$defs/PolicyEpoch"
        },
        "token_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Token Ids",
          "type": "array"
        },
        "trajectory_digest": {
          "$ref": "#/$defs/Digest"
        },
        "trajectory_id": {
          "minLength": 1,
          "title": "Trajectory Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "sample_kind",
        "trajectory_id",
        "trajectory_digest",
        "reward_evidence_id",
        "reward_evidence_digest",
        "credit_evidence_id",
        "credit_evidence_digest",
        "event_ids",
        "token_ids",
        "action_ids",
        "behavior_policy_epoch",
        "behavior_log_probability",
        "target_policy_epoch",
        "importance_sampling_weight",
        "raw_sample",
        "lineage"
      ],
      "title": "TrainingSampleProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "sloforge.io/helix/v1",
      "default": "sloforge.io/helix/v1",
      "title": "Api Version",
      "type": "string"
    },
    "batch_id": {
      "minLength": 1,
      "title": "Batch Id",
      "type": "string"
    },
    "created_at": {
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "kind": {
      "const": "TrainingBatchManifest",
      "default": "TrainingBatchManifest",
      "title": "Kind",
      "type": "string"
    },
    "learner_policy_epoch": {
      "$ref": "#/$defs/PolicyEpoch"
    },
    "lineage": {
      "items": {
        "$ref": "#/$defs/LineageReference"
      },
      "title": "Lineage",
      "type": "array"
    },
    "policy_consistency": {
      "$ref": "#/$defs/PolicyConsistency"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/TrainingSampleProvenance"
      },
      "title": "Samples",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "policy_consistency",
    "learner_policy_epoch",
    "samples",
    "created_at",
    "lineage"
  ],
  "title": "TrainingBatchManifest",
  "type": "object"
}
