{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EnvironmentStateCapsule": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "sloforge.io/helix/v1",
          "default": "sloforge.io/helix/v1",
          "title": "Api Version",
          "type": "string"
        },
        "capsule_id": {
          "minLength": 1,
          "title": "Capsule Id",
          "type": "string"
        },
        "captured_at": {
          "minLength": 1,
          "title": "Captured At",
          "type": "string"
        },
        "compatibility_fingerprint": {
          "$ref": "#/$defs/Digest"
        },
        "compatible_policy_digests": {
          "items": {
            "$ref": "#/$defs/Digest"
          },
          "title": "Compatible Policy Digests",
          "type": "array"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "kind": {
          "const": "EnvironmentStateCapsule",
          "default": "EnvironmentStateCapsule",
          "title": "Kind",
          "type": "string"
        },
        "lineage": {
          "items": {
            "$ref": "#/$defs/LineageReference"
          },
          "title": "Lineage",
          "type": "array"
        },
        "payload_byte_length": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Payload Byte Length",
          "type": "integer"
        },
        "payload_media_type": {
          "minLength": 1,
          "title": "Payload Media Type",
          "type": "string"
        },
        "payload_uri": {
          "minLength": 1,
          "title": "Payload Uri",
          "type": "string"
        },
        "policy_epoch": {
          "$ref": "#/$defs/PolicyEpoch"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state_digest": {
          "$ref": "#/$defs/Digest"
        },
        "state_schema_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "capsule_id",
        "environment_id",
        "captured_at",
        "policy_epoch",
        "state_schema_digest",
        "state_digest",
        "compatibility_fingerprint",
        "payload_uri",
        "payload_media_type",
        "payload_byte_length",
        "compatible_policy_digests",
        "lineage"
      ],
      "title": "EnvironmentStateCapsule",
      "type": "object"
    },
    "LineageReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "minLength": 1,
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "relation": {
          "$ref": "#/$defs/LineageRelation"
        }
      },
      "required": [
        "artifact_id",
        "artifact_kind",
        "relation",
        "digest"
      ],
      "title": "LineageReference",
      "type": "object"
    },
    "LineageRelation": {
      "enum": [
        "source",
        "parent",
        "derived_from",
        "evidence",
        "state",
        "policy"
      ],
      "title": "LineageRelation",
      "type": "string"
    },
    "PolicyEpoch": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "sloforge.io/helix/v1",
          "default": "sloforge.io/helix/v1",
          "title": "Api Version",
          "type": "string"
        },
        "created_at": {
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        },
        "epoch": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "kind": {
          "const": "PolicyEpoch",
          "default": "PolicyEpoch",
          "title": "Kind",
          "type": "string"
        },
        "lineage": {
          "items": {
            "$ref": "#/$defs/LineageReference"
          },
          "title": "Lineage",
          "type": "array"
        },
        "parent_epoch": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Epoch"
        },
        "parent_policy_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_digest": {
          "$ref": "#/$defs/Digest"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "training_transaction_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Transaction Id"
        }
      },
      "required": [
        "policy_id",
        "epoch",
        "policy_digest",
        "created_at",
        "lineage"
      ],
      "title": "PolicyEpoch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "sloforge.io/helix/v1",
      "default": "sloforge.io/helix/v1",
      "title": "Api Version",
      "type": "string"
    },
    "branch_point_id": {
      "minLength": 1,
      "title": "Branch Point Id",
      "type": "string"
    },
    "candidate_labels": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Candidate Labels",
      "type": "array"
    },
    "created_at": {
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "environment_state": {
      "$ref": "#/$defs/EnvironmentStateCapsule"
    },
    "event_index": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "title": "Event Index",
      "type": "integer"
    },
    "kind": {
      "const": "BranchPoint",
      "default": "BranchPoint",
      "title": "Kind",
      "type": "string"
    },
    "lineage": {
      "items": {
        "$ref": "#/$defs/LineageReference"
      },
      "title": "Lineage",
      "type": "array"
    },
    "policy_epoch": {
      "$ref": "#/$defs/PolicyEpoch"
    },
    "prefix_digest": {
      "$ref": "#/$defs/Digest"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "source_trajectory_id": {
      "minLength": 1,
      "title": "Source Trajectory Id",
      "type": "string"
    },
    "token_index": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "title": "Token Index",
      "type": "integer"
    }
  },
  "required": [
    "branch_point_id",
    "source_trajectory_id",
    "event_index",
    "token_index",
    "environment_state",
    "policy_epoch",
    "prefix_digest",
    "seed",
    "created_at",
    "reason",
    "candidate_labels",
    "lineage"
  ],
  "title": "BranchPoint",
  "type": "object"
}
