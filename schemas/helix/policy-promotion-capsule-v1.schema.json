{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "EvidencePointer": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "minLength": 1,
          "title": "Captured At",
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "digest",
        "media_type",
        "captured_at"
      ],
      "title": "EvidencePointer",
      "type": "object"
    },
    "LineageReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "minLength": 1,
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "relation": {
          "$ref": "#/$defs/LineageRelation"
        }
      },
      "required": [
        "artifact_id",
        "artifact_kind",
        "relation",
        "digest"
      ],
      "title": "LineageReference",
      "type": "object"
    },
    "LineageRelation": {
      "enum": [
        "source",
        "parent",
        "derived_from",
        "evidence",
        "state",
        "policy"
      ],
      "title": "LineageRelation",
      "type": "string"
    },
    "PolicyEpoch": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "sloforge.io/helix/v1",
          "default": "sloforge.io/helix/v1",
          "title": "Api Version",
          "type": "string"
        },
        "created_at": {
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        },
        "epoch": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "kind": {
          "const": "PolicyEpoch",
          "default": "PolicyEpoch",
          "title": "Kind",
          "type": "string"
        },
        "lineage": {
          "items": {
            "$ref": "#/$defs/LineageReference"
          },
          "title": "Lineage",
          "type": "array"
        },
        "parent_epoch": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Epoch"
        },
        "parent_policy_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_digest": {
          "$ref": "#/$defs/Digest"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "training_transaction_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Transaction Id"
        }
      },
      "required": [
        "policy_id",
        "epoch",
        "policy_digest",
        "created_at",
        "lineage"
      ],
      "title": "PolicyEpoch",
      "type": "object"
    },
    "PromotionDecision": {
      "enum": [
        "promote",
        "hold",
        "rollback"
      ],
      "title": "PromotionDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "sloforge.io/helix/v1",
      "default": "sloforge.io/helix/v1",
      "title": "Api Version",
      "type": "string"
    },
    "approved_by": {
      "minLength": 1,
      "title": "Approved By",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/PromotionDecision"
    },
    "evaluation_evidence": {
      "items": {
        "$ref": "#/$defs/EvidencePointer"
      },
      "title": "Evaluation Evidence",
      "type": "array"
    },
    "from_policy_epoch": {
      "$ref": "#/$defs/PolicyEpoch"
    },
    "kind": {
      "const": "PolicyPromotionCapsule",
      "default": "PolicyPromotionCapsule",
      "title": "Kind",
      "type": "string"
    },
    "lineage": {
      "items": {
        "$ref": "#/$defs/LineageReference"
      },
      "title": "Lineage",
      "type": "array"
    },
    "promoted_at": {
      "minLength": 1,
      "title": "Promoted At",
      "type": "string"
    },
    "promotion_id": {
      "minLength": 1,
      "title": "Promotion Id",
      "type": "string"
    },
    "rollback_policy_epoch": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyEpoch"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "to_policy_epoch": {
      "$ref": "#/$defs/PolicyEpoch"
    },
    "transaction_id": {
      "minLength": 1,
      "title": "Transaction Id",
      "type": "string"
    }
  },
  "required": [
    "promotion_id",
    "transaction_id",
    "from_policy_epoch",
    "to_policy_epoch",
    "decision",
    "evaluation_evidence",
    "approved_by",
    "promoted_at",
    "lineage"
  ],
  "title": "PolicyPromotionCapsule",
  "type": "object"
}
