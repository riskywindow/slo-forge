{
  "$defs": {
    "AdmissionPolicy": {
      "additionalProperties": false,
      "properties": {
        "maximum_queue_time_ms": {
          "exclusiveMinimum": 0.0,
          "title": "Maximum Queue Time Ms",
          "type": "number"
        },
        "queue_capacity": {
          "exclusiveMinimum": 0,
          "title": "Queue Capacity",
          "type": "integer"
        },
        "reject_when_predicted_late": {
          "default": true,
          "title": "Reject When Predicted Late",
          "type": "boolean"
        },
        "shed_below_priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "queue_capacity",
        "maximum_queue_time_ms"
      ],
      "title": "AdmissionPolicy",
      "type": "object"
    },
    "ArrivalKind": {
      "enum": [
        "poisson",
        "deterministic",
        "trace",
        "bursty"
      ],
      "title": "ArrivalKind",
      "type": "string"
    },
    "ArrivalProcess": {
      "additionalProperties": false,
      "properties": {
        "burst_factor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Burst Factor"
        },
        "kind": {
          "$ref": "#/$defs/ArrivalKind"
        },
        "rate_per_second": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Per Second"
        },
        "trace_uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Uri"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ArrivalProcess",
      "type": "object"
    },
    "ArtifactDigest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ArtifactDigest",
      "type": "object"
    },
    "AutoscalingPolicy": {
      "additionalProperties": false,
      "properties": {
        "control_interval_seconds": {
          "exclusiveMinimum": 0.0,
          "title": "Control Interval Seconds",
          "type": "number"
        },
        "maximum_change_per_interval": {
          "exclusiveMinimum": 0,
          "title": "Maximum Change Per Interval",
          "type": "integer"
        },
        "minimum_samples": {
          "exclusiveMinimum": 0,
          "title": "Minimum Samples",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "disabled",
            "reactive",
            "predictive"
          ],
          "title": "Mode",
          "type": "string"
        },
        "safety_margin": {
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Safety Margin",
          "type": "number"
        },
        "scale_down_cooldown_seconds": {
          "minimum": 0.0,
          "title": "Scale Down Cooldown Seconds",
          "type": "number"
        },
        "scale_up_cooldown_seconds": {
          "minimum": 0.0,
          "title": "Scale Up Cooldown Seconds",
          "type": "number"
        },
        "target_utilization": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Target Utilization",
          "type": "number"
        }
      },
      "required": [
        "mode",
        "target_utilization",
        "control_interval_seconds",
        "scale_up_cooldown_seconds",
        "scale_down_cooldown_seconds",
        "minimum_samples",
        "safety_margin",
        "maximum_change_per_interval"
      ],
      "title": "AutoscalingPolicy",
      "type": "object"
    },
    "BatchingPolicy": {
      "additionalProperties": false,
      "properties": {
        "dynamic_batching": {
          "default": true,
          "title": "Dynamic Batching",
          "type": "boolean"
        },
        "maximum_active_sequences": {
          "exclusiveMinimum": 0,
          "title": "Maximum Active Sequences",
          "type": "integer"
        },
        "maximum_batch_delay_ms": {
          "minimum": 0.0,
          "title": "Maximum Batch Delay Ms",
          "type": "number"
        },
        "maximum_batched_tokens": {
          "exclusiveMinimum": 0,
          "title": "Maximum Batched Tokens",
          "type": "integer"
        }
      },
      "required": [
        "maximum_active_sequences",
        "maximum_batched_tokens",
        "maximum_batch_delay_ms"
      ],
      "title": "BatchingPolicy",
      "type": "object"
    },
    "BudgetSpec": {
      "additionalProperties": false,
      "properties": {
        "maximum_real_trials": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Real Trials"
        },
        "profiling_budget_usd": {
          "minimum": 0.0,
          "title": "Profiling Budget Usd",
          "type": "number"
        },
        "profiling_duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profiling Duration Seconds"
        },
        "reserve_fraction": {
          "default": 0.15,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Reserve Fraction",
          "type": "number"
        }
      },
      "required": [
        "profiling_budget_usd"
      ],
      "title": "BudgetSpec",
      "type": "object"
    },
    "CanaryPolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "initial_weight": {
          "default": 0.05,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Initial Weight",
          "type": "number"
        },
        "maximum_slo_violation_delta": {
          "default": 0.01,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Slo Violation Delta",
          "type": "number"
        },
        "minimum_requests": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Minimum Requests",
          "type": "integer"
        },
        "observation_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0.0,
          "title": "Observation Seconds",
          "type": "number"
        }
      },
      "title": "CanaryPolicy",
      "type": "object"
    },
    "ChunkedPrefillSpec": {
      "additionalProperties": false,
      "properties": {
        "chunk_tokens": {
          "default": 512,
          "exclusiveMinimum": 0,
          "title": "Chunk Tokens",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "ChunkedPrefillSpec",
      "type": "object"
    },
    "ColdStartStrategy": {
      "additionalProperties": false,
      "properties": {
        "minimum_warm_replicas": {
          "minimum": 0,
          "title": "Minimum Warm Replicas",
          "type": "integer"
        },
        "predicted_p95_startup_ms": {
          "exclusiveMinimum": 0.0,
          "title": "Predicted P95 Startup Ms",
          "type": "number"
        },
        "prefetch_model": {
          "default": true,
          "title": "Prefetch Model",
          "type": "boolean"
        },
        "readiness_timeout_seconds": {
          "exclusiveMinimum": 0.0,
          "title": "Readiness Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "minimum_warm_replicas",
        "readiness_timeout_seconds",
        "predicted_p95_startup_ms"
      ],
      "title": "ColdStartStrategy",
      "type": "object"
    },
    "CompilationSpec": {
      "additionalProperties": false,
      "properties": {
        "cuda_graphs": {
          "default": false,
          "title": "Cuda Graphs",
          "type": "boolean"
        },
        "graph_batch_sizes": {
          "default": [],
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Graph Batch Sizes",
          "type": "array"
        },
        "mode": {
          "default": "eager",
          "enum": [
            "eager",
            "compile",
            "ahead_of_time"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "CompilationSpec",
      "type": "object"
    },
    "CpuSpec": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "minLength": 1,
          "title": "Architecture",
          "type": "string"
        },
        "logical_cores": {
          "exclusiveMinimum": 0,
          "title": "Logical Cores",
          "type": "integer"
        },
        "measured_memory_bandwidth_gbps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Memory Bandwidth Gbps"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "numa_nodes": {
          "exclusiveMinimum": 0,
          "title": "Numa Nodes",
          "type": "integer"
        },
        "physical_cores": {
          "exclusiveMinimum": 0,
          "title": "Physical Cores",
          "type": "integer"
        }
      },
      "required": [
        "architecture",
        "model",
        "physical_cores",
        "logical_cores",
        "numa_nodes"
      ],
      "title": "CpuSpec",
      "type": "object"
    },
    "DType": {
      "enum": [
        "float32",
        "tf32",
        "float16",
        "bfloat16",
        "fp8",
        "int8",
        "int4"
      ],
      "title": "DType",
      "type": "string"
    },
    "DistributionKind": {
      "enum": [
        "fixed",
        "empirical",
        "lognormal"
      ],
      "title": "DistributionKind",
      "type": "string"
    },
    "DistributionSpec": {
      "additionalProperties": false,
      "properties": {
        "empirical": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WeightedValue"
          },
          "title": "Empirical",
          "type": "array"
        },
        "fixed_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed Value"
        },
        "kind": {
          "$ref": "#/$defs/DistributionKind"
        },
        "log_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Mean"
        },
        "log_stddev": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Stddev"
        },
        "maximum": {
          "exclusiveMinimum": 0,
          "title": "Maximum",
          "type": "integer"
        },
        "minimum": {
          "default": 0,
          "minimum": 0,
          "title": "Minimum",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "maximum"
      ],
      "title": "DistributionSpec",
      "type": "object"
    },
    "DocumentMetadata": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "generation": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "uid": {
          "minLength": 1,
          "title": "Uid",
          "type": "string"
        }
      },
      "required": [
        "name",
        "uid",
        "created_at"
      ],
      "title": "DocumentMetadata",
      "type": "object"
    },
    "EngineSpec": {
      "additionalProperties": false,
      "properties": {
        "chunked_prefill": {
          "$ref": "#/$defs/ChunkedPrefillSpec"
        },
        "compilation": {
          "$ref": "#/$defs/CompilationSpec"
        },
        "dtype": {
          "$ref": "#/$defs/DType"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "maximum_active_sequences": {
          "exclusiveMinimum": 0,
          "title": "Maximum Active Sequences",
          "type": "integer"
        },
        "maximum_batched_tokens": {
          "exclusiveMinimum": 0,
          "title": "Maximum Batched Tokens",
          "type": "integer"
        },
        "pipeline_parallelism": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Pipeline Parallelism",
          "type": "integer"
        },
        "prefix_cache": {
          "$ref": "#/$defs/PrefixCacheSpec"
        },
        "quantization": {
          "$ref": "#/$defs/Quantization",
          "default": "none"
        },
        "runtime": {
          "enum": [
            "transformers",
            "vllm",
            "sglang",
            "tensorrt_llm",
            "mock"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "speculative_decoding": {
          "$ref": "#/$defs/SpeculativeDecodingSpec"
        },
        "tensor_parallelism": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Tensor Parallelism",
          "type": "integer"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "runtime",
        "version",
        "dtype",
        "maximum_batched_tokens",
        "maximum_active_sequences"
      ],
      "title": "EngineSpec",
      "type": "object"
    },
    "Extensions": {
      "additionalProperties": false,
      "description": "Validated vendor extension fields serialized as a plain JSON object.",
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*/[A-Za-z][A-Za-z0-9_.-]*$": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "title": "Extensions",
      "type": "object"
    },
    "FluidityConstraint": {
      "additionalProperties": false,
      "properties": {
        "maximum_missed_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Missed Fraction",
          "type": "number"
        },
        "token_deadline_ms": {
          "exclusiveMinimum": 0.0,
          "title": "Token Deadline Ms",
          "type": "number"
        }
      },
      "required": [
        "token_deadline_ms",
        "maximum_missed_fraction"
      ],
      "title": "FluidityConstraint",
      "type": "object"
    },
    "GpuSpec": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "minLength": 1,
          "title": "Architecture",
          "type": "string"
        },
        "ecc_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ecc Enabled"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "measured_compute_tflops": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Compute Tflops"
        },
        "measured_memory_bandwidth_gbps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Memory Bandwidth Gbps"
        },
        "memory_clock_mhz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Clock Mhz"
        },
        "pcie_generation": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pcie Generation"
        },
        "pcie_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pcie Width"
        },
        "product": {
          "minLength": 1,
          "title": "Product",
          "type": "string"
        },
        "uuid": {
          "minLength": 1,
          "title": "Uuid",
          "type": "string"
        },
        "vram_bytes": {
          "exclusiveMinimum": 0,
          "title": "Vram Bytes",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "product",
        "architecture",
        "uuid",
        "vram_bytes"
      ],
      "title": "GpuSpec",
      "type": "object"
    },
    "HardwareSpec": {
      "additionalProperties": false,
      "properties": {
        "cloud": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cloud"
        },
        "container_memory_limit_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Memory Limit Bytes"
        },
        "cpu": {
          "$ref": "#/$defs/CpuSpec"
        },
        "cuda_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cuda Version"
        },
        "driver_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driver Version"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "fingerprint": {
          "$ref": "#/$defs/ArtifactDigest"
        },
        "gpu_count": {
          "default": 0,
          "minimum": 0,
          "title": "Gpu Count",
          "type": "integer"
        },
        "gpus": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GpuSpec"
          },
          "title": "Gpus",
          "type": "array"
        },
        "hourly_price_usd": {
          "minimum": 0.0,
          "title": "Hourly Price Usd",
          "type": "number"
        },
        "instance_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Type"
        },
        "library_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Library Versions",
          "type": "object"
        },
        "region": {
          "minLength": 1,
          "title": "Region",
          "type": "string"
        },
        "system_memory_bytes": {
          "exclusiveMinimum": 0,
          "title": "System Memory Bytes",
          "type": "integer"
        },
        "topology": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TopologyLink"
          },
          "title": "Topology",
          "type": "array"
        }
      },
      "required": [
        "fingerprint",
        "cpu",
        "system_memory_bytes",
        "hourly_price_usd",
        "region"
      ],
      "title": "HardwareSpec",
      "type": "object"
    },
    "JsonValue": {},
    "LicenseMetadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
