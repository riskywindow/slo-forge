    "LoraSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "checksum": {
          "$ref": "#/$defs/ArtifactDigest"
        },
        "merged": {
          "default": false,
          "title": "Merged",
          "type": "boolean"
        },
        "rank": {
          "exclusiveMinimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
