    "MetricConstraint": {
      "additionalProperties": false,
      "properties": {
        "maximum_ms": {
          "exclusiveMinimum": 0.0,
          "title": "Maximum Ms",
          "type": "number"
        },
        "percentile": {
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "Percentile",
          "type": "number"
